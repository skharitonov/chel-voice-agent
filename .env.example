# Скопируй в .env и заполни. .env в .gitignore — НЕ коммитить.

# --- Фаза 1: текстовая симуляция (обязательно) ---
# Выбор LLM-бэкенда: anthropic (прямой API) | openrouter (OpenAI-совместимый шлюз)
LLM_BACKEND=openrouter

# Вариант 1 — OpenRouter (LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=sk-or-...
# Слаги моделей см. https://openrouter.ai/models
LLM_DIALOGUE_MODEL=anthropic/claude-sonnet-4.6
LLM_POSTPROCESS_MODEL=anthropic/claude-3.5-haiku
# Необязательно (атрибуция приложения в рейтингах OpenRouter):
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=chel-voice-agent
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # переопределение по умолчанию

# Вариант 2 — прямой Anthropic API (LLM_BACKEND=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_DIALOGUE_MODEL=claude-sonnet-4-6
# LLM_POSTPROCESS_MODEL=claude-haiku-4-5-20251001

# --- Фаза 2: локальный голос (LiveKit console) ---
# Ключи провайдеров:
DEEPGRAM_API_KEY=
INWORLD_API_KEY=            # ВАЖНО: ключ Inworld в формате Base64 (см. platform.inworld.ai)

# Параметры голосового движка (по умолчанию — русский):
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANG=multi        # 'multi' (Nova-3 multilingual) или 'ru'
INWORLD_LANG=ru-RU
INWORLD_VOICE=             # id русского голоса Inworld (см. List voices); пусто = голос по умолчанию
INWORLD_TTS_MODEL=         # пусто = модель плагина по умолчанию (напр. inworld-tts-1.5-mini)
INWORLD_SPEAKING_RATE=     # audioConfig.speakingRate, диапазон [0.5, 1.5]; пусто = 1.0 (напр. 0.8)
INWORLD_TEMPERATURE=       # случайность синтеза, диапазон (0, 2]; пусто = 1.0 (напр. 1.4)

# Модель реплик в ГОЛОСЕ. Ответ СТРИМИТСЯ в TTS пофразово (первый звук быстро),
# поэтому даже Sonnet звучит отзывчиво. Слаг должен быть в списке твоего прокси —
# посмотреть: python scripts/list_models.py
#   пусто / sonnet → Sonnet (качество режиссуры)
#   haiku          → Haiku (на тесте — несвязные реплики, не рекомендуется)
#   <слаг модели>  → по бенчмарку (scripts/bench_models.py) быстрее и связнее всех
#                    google/gemini-2.5-flash (TTFT ~0.45с); Sonnet ~0.8с (качество)
VOICE_DIALOGUE_MODEL=google/gemini-2.5-flash

# Foreground-филлер: мгновенная вставка «Так, секунду…» перед ответом. При
# стриминге обычно НЕ нужен (давал дублирование). off (по умолчанию) | on
VOICE_FILLER=off

# Параметры звонка (берутся ядром из окружения):
# Фоновый шум офиса под голос агента (реализм «звоню из офиса»; слышен, пока
# агент говорит, и попадает в запись --record). Клипы:
#   crowded — голоса коллег/менеджеров (по умолч., слышен) | typing — клавиатуры |
#   office — гул вентиляции (очень тихий) | off — выключить
#   можно комбинировать через '+': напр. crowded+typing
CHEL_AMBIENCE=crowded
CHEL_AMBIENCE_VOLUME=0.2    # 0..1; 0.15–0.3 — субтильно; 0/off = выключить

CHEL_MODE=A                # A (квалификация) | B (поиск ЛПР)
CHEL_PHONE=+7-LOCAL-TEST
CHEL_COMPANY=Тестовый рудник
CHEL_ROLE=                 # целевая роль ЛПР для режима B
CHEL_LPR_NAME=             # ФИО энергетика из ОСИНТ (опц., адресное открытие)

# LiveKit Cloud нужен ТОЛЬКО для удалённого режима (dev/start). Для локального
# console-режима оставь пустыми — voice_core подставит безопасные заглушки
# (console работает unregistered и к серверу не подключается):
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
